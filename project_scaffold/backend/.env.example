# ==============================================================================
# AURASKIN AI SKIN INTELLIGENCE & PERSONALIZED PLANNER
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (BACKEND)
# ==============================================================================

# Core Project Configuration
PROJECT_NAME="AI Skin Intelligence & Personalized Skincare Planner"
ENVIRONMENT=production
DEBUG=False
VERSION="4.0.0"
LOG_LEVEL=INFO

# Server Concurrency & Performance
WEB_CONCURRENCY=2

# PostgreSQL Database Configuration
# Option A: Discrete connection parameters
POSTGRES_USER=auraskin_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=auraskin_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Option B: Managed Cloud Database URL (AWS RDS / Azure Database for PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/auraskin_db

# Connection Pooling Configuration
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# JSON Web Token (JWT) Authentication
# Generate a secure 32+ character key: openssl rand -hex 32
JWT_SECRET_KEY=your_production_jwt_secret_key_minimum_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (JSON array or comma-separated string)
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://your-domain.com"]

# Frontend Public URL (Used in email link generation)
FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration (Password Reset & Smart Reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=noreply@auraskin.ai
SMTP_FROM_NAME=AuraSkin AI Skin Intelligence
